# AI tutor configuration
#
# The key is read by `server.ts` only. It is never bundled into the browser:
# the static GitHub Pages build ships no key and no AI code, and the browser
# talks to `/api/ai/*` (or to `VITE_AI_BASE_URL` when the gateway lives on
# another host, e.g. Cloud Run).
GEMINI_API_KEY=

# Where the browser should send tutor requests, when the gateway is not on the
# same origin as the page. Leave empty for same-origin (`/api/ai/*`).
# Example: https://insco-tutor-xxxx.a.run.app
VITE_AI_BASE_URL=

# Server port
PORT=3000

# Which Google interface to call.
#   auto         — Interactions API first, legacy models API only if the
#                  endpoint is unavailable (default)
#   interactions — Interactions API only (fails loudly if the key cannot use it)
#   legacy       — old models.generateContentStream path only
TUTOR_API_MODE=auto

# Optional model override for the answer. The default and its fallbacks live in
# src/ai/contract.ts (`TUTOR_MODELS`), so this only needs setting to pin a model.
TUTOR_MODEL=

# Rate limits and budget (per IP unless noted)
TUTOR_RATE_PER_MINUTE=10
TUTOR_RATE_PER_DAY=200
# Hard daily cap across all IPs, a cost guard for the API key.
TUTOR_DAILY_LIMIT=300
TUTOR_TIMEOUT_MS=45000
