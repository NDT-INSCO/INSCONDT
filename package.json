{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:academy": "tsx --test tests/academy.test.tsx",
    "test:book": "tsx --test tests/bookViewer.test.tsx",
    "test:leaderboard": "tsx --test tests/knowledgeLeaderboard.test.tsx",
    "test:roadmap": "tsx --test tests/academyRoadmap.test.tsx",
    "test:cert": "tsx --test tests/certificationCenter.test.tsx",
    "test:company": "tsx --test tests/companyProfile.test.tsx",
    "test:edb": "tsx --test tests/edb.test.tsx",
    "test:epub": "tsx --test tests/epub.test.tsx",
    "test:ai": "tsx --test tests/aiContract.test.tsx && tsx --test tests/aiTransport.test.ts && tsx --test tests/aiSearch.test.tsx && tsx --test tests/aiUi.test.tsx",
    "test:nde-ed": "tsx --test tests/ndeEdProgress.test.tsx && tsx --test tests/ndeEdData.test.tsx && tsx --test tests/ndeEdCatalog.test.tsx",
    "test": "npm run test:company && npm run test:academy && npm run test:book && npm run test:leaderboard && npm run test:roadmap && npm run test:cert && npm run test:edb && npm run test:epub && npm run test:ai && npm run test:nde-ed && npm run test:practical && npm run test:review && npm run test:paths && npm run test:routing && npm run test:smoke",
    "verify": "npm run lint && npm run test && npm run edb:check && npm run edb:verify:published && npm run epub:check && npm run links:check && npm run build && npm run site:check",
    "edb:build": "tsx scripts/build-edb.ts",
    "edb:check": "tsx scripts/build-edb.ts --check",
    "test:smoke": "tsx --test tests/academySmoke.test.tsx",
    "test:practical": "tsx --test tests/practicalAssessment.test.tsx",
    "test:review": "tsx --test tests/reviewAndLinks.test.tsx",
    "test:paths": "tsx --test tests/learningPaths.test.tsx",
    "test:routing": "tsx --test tests/routingAndLanguage.test.tsx",
    "links:check": "tsx scripts/check-links.ts",
    "links:check:online": "tsx scripts/check-links.ts --online",
    "edb:verify:published": "tsx scripts/verify-published-edb.ts",
    "epub:build": "tsx scripts/build-epub.ts",
    "epub:check": "tsx scripts/build-epub.ts --check",
    "site:check": "tsx scripts/check-published-site.ts"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.0.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.186.1",
    "vite": "^8.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "autoprefixer": "^10.4.21",
    "fast-xml-parser": "^5.11.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
